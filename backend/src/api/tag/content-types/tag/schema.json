{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag"
  },
  "options": {
    "draftAndPublish": false
  },
  "indexes": [
    {
      "name": "tags_label_unique",
      "columns": ["label"],
      "type": "unique"
    }
  ],
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80
    },
    "audience": {
      "type": "enumeration",
      "enum": ["collaborateur", "manager", "both"],
      "default": "collaborateur",
      "required": true
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-lucide-icons.icon",
      "default": "compass",
      "required": true
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "position": {
      "type": "integer",
      "default": 0,
      "required": true
    }
  }
}
