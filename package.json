{
  "name": "moodly-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Moodly mobile demo and Strapi starter",
  "scripts": {
    "postinstall": "npm ci --prefix mobile",
    "start": "npm --prefix mobile start",
    "web": "npm --prefix mobile run web",
    "android": "npm --prefix mobile run android",
    "ios": "npm --prefix mobile run ios",
    "typecheck": "npm --prefix mobile run typecheck",
    "backend:install": "npm ci --prefix backend",
    "backend:dev": "npm --prefix backend run develop",
    "backend:demo": "npm --prefix backend run demo",
    "backend:test": "npm --prefix backend test",
    "backend:test:api": "npm --prefix backend run test:api"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
